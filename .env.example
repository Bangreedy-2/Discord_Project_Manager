# Bot token from the Discord developer portal
DISCORD_TOKEN=
# Supabase pooler connection string (Project settings > Database > Connection pooling)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Guild to sync commands to instantly during development; leave empty for global sync
DEV_GUILD_ID=
# Optional: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
